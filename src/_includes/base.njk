<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
</head>
<body>
  <div class="wrap">

    <div class="bar">
      <div class="ident">
        <span class="lamp" aria-hidden="true"></span>
        <span class="who"><a href="/">{{ site.title }}</a></span>
        <span class="ver mono">ver {{ site.version }}</span>
      </div>
      <nav>
        {%- for s in site.sections %}
        <a href="/{{ s.key }}/"{% if section == s.key %} class="on" aria-current="page"{% endif %}>{{ s.label }}</a>
        {%- endfor %}
        <a href="/about/"{% if section == "about" %} class="on" aria-current="page"{% endif %}>about</a>
      </nav>
    </div>

    <main>
      {{ content | safe }}
    </main>

    <footer class="mono">
      <span>{{ site.url | replace("https://", "") }}</span>
      <button id="mode" type="button">light / dark</button>
    </footer>

  </div>

  <script>
    (function () {
      var root = document.documentElement;
      var saved = localStorage.getItem("theme");
      if (saved) root.classList.add(saved);

      document.getElementById("mode").addEventListener("click", function () {
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = root.classList.contains("dark") ||
                     (prefersDark && !root.classList.contains("light"));
        root.classList.toggle("dark", !isDark);
        root.classList.toggle("light", isDark);
        localStorage.setItem("theme", isDark ? "light" : "dark");
      });
    })();
  </script>
</body>
</html>
