<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="alternate" type="application/atom+xml" href="{{ '/feed.xml' | url }}" title="{{ site.title }}">
</head>
<body>
  <div class="wrap">

    <div class="bar">
      <div class="ident">
        {%- set newest = collections.everything | first %}
        {%- set fresh = newest.date | isFresh %}
        <span class="lamp{% if fresh %} on{% endif %}"
              title="{% if fresh %}Updated in the last 30 days{% else %}No posts in the last 30 days{% endif %}"></span>
        <span class="who"><a href="{{ '/' | url }}">{{ site.title }}</a></span>
        <span class="ver mono">ver {{ site.version }}</span>
      </div>
      <nav>
        {%- for s in site.sections %}
        <a href="{{ ('/' + s.key + '/') | url }}"{% if section == s.key %} class="on" aria-current="page"{% endif %}>{{ s.label }}</a>
        {%- endfor %}
        <a href="{{ '/about/' | url }}"{% if section == "about" %} class="on" aria-current="page"{% endif %}>about</a>
      </nav>
    </div>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <span>{{ site.url | replace("https://", "") }}</span>
      <span class="ver">ver {{ site.version }}</span>
    </footer>

  </div>
</body>
</html>
