---
layout: base.njk
---
<article class="post">
  <div class="post-head">
    <div class="meta">
      {{ date | date }}{% if kind %} · {{ kind }}{% endif %}
    </div>
    <h1>{{ title }}</h1>
    {% if blurb %}<p class="blurb">{{ blurb }}</p>{% endif %}
  </div>

  <div class="prose">
    {{ content | safe }}
  </div>

  {% if source %}<p class="source"><a class="inline" href="{{ source }}">View original source ↗</a></p>{% endif %}

  <a class="back" href="{{ ('/' + section + '/') | url }}">← {{ section | sectionTitle }}</a>
</article>
